# Chave da API Gemini (a primeira preenchida é usada, nesta ordem):
CUSTOM_GEMINI_API_KEY=""
RPG_GEMINI_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Modo padrão do Mestre: 'flash' (rápido) ou 'pro' (prosa densa). O jogador pode trocar nas Configurações.
RPG_MODEL_MODE="flash"

# Modelos usados em cada modo (opcional). A ordem de fallback é:
#   pro   → GM_MODEL_PRO, GM_MODEL_FLASH, GM_MODEL_LITE
#   flash → GM_MODEL_FLASH, GM_MODEL_LITE, GM_MODEL_PRO
# GM_MODEL_PRO="gemini-3.1-pro-preview"
# GM_MODEL_FLASH="gemini-3.8-flash"
# GM_MODEL_LITE="gemini-3.1-flash-lite"

# Tempo máximo por chamada ao modelo, em ms (opcional).
# GM_TIMEOUT_MS=60000

# Porta do servidor (opcional).
# PORT=3000
