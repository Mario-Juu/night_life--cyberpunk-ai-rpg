# Chave da API Gemini do SERVIDOR (opcional: cada jogador pode colocar a própria chave nas
# Configurações do jogo — ela tem prioridade e fica só no navegador dele).
# No plano gratuito cada chave tem ~20 pedidos/dia POR MODELO: para vários jogadores, prefira
# que cada um use a própria chave (grátis em https://aistudio.google.com/apikey).
# A primeira preenchida é usada, nesta ordem:
CUSTOM_GEMINI_API_KEY=""
RPG_GEMINI_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Chave usada SÓ pelos evals ao vivo (npm run eval:live).
TEST_API_KEY=""

# Cadeias de modelos (opcional), em ordem de tentativa. Só flash/flash-lite: modelos "pro" são ignorados.
# Narração e telefone: desce de versão em versão do flash antes de ir para o flash-lite.
# GM_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Intérprete e resumos (classificação): flash-lite primeiro, poupando a cota do flash.
# GM_MODELS_FAST="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash"

# Tempo máximo de UMA tentativa num modelo, em ms (opcional). Um 503 pode levar 60 s para chegar:
# cortar cedo e passar ao próximo modelo é mais rápido do que esperar.
# GM_ATTEMPT_MS_FAST=20000
# GM_ATTEMPT_MS_NARRATE=30000
# Orçamento total de uma resposta do Mestre (todas as tentativas), em ms.
# GM_BUDGET_MS=110000

# Porta do servidor (opcional).
# PORT=3000

# Cache EXPLÍCITO das instruções fixas nos modelos flash — EXPERIMENTAL, desligado por padrão.
# Só tem efeito com chave PAGA (na gratuita o Google recusa). Economiza ~90% nos ~6–8 mil tokens fixos; armazenamento ~$0,004/h por modelo.
# GM_EXPLICIT_CACHE="on"
